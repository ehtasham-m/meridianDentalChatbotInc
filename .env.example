# Application Environment Variables
# Google Gemini API key for server-side AI Virtual Receptionist and tool-using agent
GEMINI_API_KEY=

# Resend API key for appointment booking notifications (server-side secret)
RESEND_API_KEY=

# Must use a sender address on a domain verified in Resend.
# Example: Meridian Dental <appointments@your-clinic-domain.com>
RESEND_FROM_EMAIL=

# Inbox that receives clinic notifications
CLINIC_NOTIFICATION_EMAIL=
